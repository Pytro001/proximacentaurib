#!/bin/sh
# Git credential helper: reads GitHub PAT from .github-token in repo root.
# Used so agent/automation can push without interactive auth.
# Create .github-token with your PAT (one line, no quotes). Add to .gitignore.
while read -r line; do [ -z "$line" ] && break; done
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
token=""
[ -n "$ROOT" ] && [ -f "$ROOT/.github-token" ] && token=$(cat "$ROOT/.github-token" | tr -d '\n\r')
if [ -n "$token" ]; then
  echo "username=Pytro001"
  echo "password=$token"
fi
